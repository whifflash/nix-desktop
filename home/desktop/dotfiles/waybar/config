[
// Inspired by https://github.com/Pipshag/dotfiles_gruvbox/tree/master/.config/waybar
{
    "include": [
        "~/.config/waybar/modules.json",
        "~/.config/waybar/ornamental.json",
    ],


    "reload_style_on_change": true,

    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)

    "modules-left": [
        @WB_DISPLAY_MODULES@
        "custom/theme",
        "custom/notifications",
        "backlight",
        "clock#date",
        "custom/L2R-arrow#one",
        "custom/L2R-arrow#two",
        "custom/L2R-arrow#three",
        "custom/window-count",
        "sway/window",
        "niri/window"
        ],
    "modules-center": [
        "custom/L2R-ramp#inv",
        "sway/workspaces",
        "niri/workspaces",
        "custom/L2R-ramp"
        ],
    "modules-right": [
        "custom/R2L-arrow#three",
        "battery",
        "custom/R2L-arrow#two",
        "temperature", "cpu",
        "custom/R2L-arrow#one",
        "pulseaudio", "pulseaudio#mic", "clock#time"
        ],

},
{
    "include": [
        "~/.config/waybar/modules.json",
        "~/.config/waybar/ornamental.json",
    ],


    "reload_style_on_change": true,

    "layer": "top", // Waybar at top layer
    "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)

    "modules-left": [
        "custom/weather",
        "custom/L2R-arrow#one",
        "custom/L2R-arrow#two",
        "custom/L2R-arrow#three"
        ],
    "modules-center": [
        "custom/L2R-ramp#inv",
        "custom/L2R-ramp"
        ],
    "modules-right": [
        "custom/R2L-arrow#three",
        "custom/R2L-arrow#two",
        "custom/R2L-arrow#one",
        @WB_VPN_MODULES@ "network", "tray"
    ],
}
]
